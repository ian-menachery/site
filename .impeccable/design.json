  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Resume and other main actions; swaps to a solid cobalt fill on hover.",
      "html": "<a class=\"ds-btn ds-btn-primary\" href=\"#\">Resume (PDF)</a>",
      "css": ".ds-btn{display:inline-flex;align-items:center;min-height:40px;padding:0 16px;font:600 .90625rem/1 var(--font-display);color:var(--ink);background:transparent;border:1px solid var(--rule);border-radius:6px;text-decoration:none;cursor:pointer;transition:background-color 120ms ease-out,color 120ms ease-out,border-color 120ms ease-out}.ds-btn:focus-visible{outline:2px solid var(--focus);outline-offset:3px}.ds-btn-primary{background:var(--ink);border-color:var(--ink);color:var(--ground)}.ds-btn-primary:hover{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Secondary action beside the primary; fills with Raised Grey on hover.",
      "html": "<a class=\"ds-btn ds-btn-quiet\" href=\"#\">Contact</a>",
      "css": ".ds-btn{display:inline-flex;align-items:center;min-height:40px;padding:0 16px;font:600 .90625rem/1 var(--font-display);color:var(--ink);background:transparent;border:1px solid var(--rule);border-radius:6px;text-decoration:none;cursor:pointer;transition:background-color 120ms ease-out,color 120ms ease-out,border-color 120ms ease-out}.ds-btn:focus-visible{outline:2px solid var(--focus);outline-offset:3px}.ds-btn-quiet:hover{background:var(--ground-2)}"
    },
    {
      "name": "Demo Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Number, text and select inputs in demos.",
      "html": "<label class=\"ds-label\">Stack (bb) <input class=\"ds-input\" type=\"number\" value=\"10\"></label>",
      "css": ".ds-label{font-family:var(--font-display);font-size:.9375rem;color:var(--ink)}.ds-input{font-family:var(--font-display);font-size:.9375rem;font-variant-numeric:tabular-nums;color:var(--ink);background:var(--ground-2);border:1px solid var(--rule);border-radius:6px;padding:6px 8px;min-height:36px}.ds-input:hover{border-color:var(--ink-2)}.ds-input:focus-visible{outline:2px solid var(--focus);outline-offset:3px}"
    },
    {
      "name": "Masthead",
      "kind": "nav",
      "refersTo": "nav-link",
      "description": "Name at left, Graphite nav links that brighten and draw a cobalt underline on hover, theme switch at right.",
      "html": "<header class=\"ds-mast\"><a class=\"ds-name ds-ui\" href=\"#\">Ian Menachery</a><nav><a class=\"ds-ui\" href=\"#\">Work</a><a class=\"ds-ui\" href=\"#\">Lab</a><a class=\"ds-ui\" href=\"#\">Resume</a><button class=\"ds-toggle\" aria-label=\"Switch to light theme\"><svg viewBox=\"0 0 20 20\" width=\"20\" height=\"20\" aria-hidden=\"true\"><circle cx=\"10\" cy=\"10\" r=\"7.25\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M10 2.75a7.25 7.25 0 0 1 0 14.5z\" fill=\"currentColor\"/></svg></button></nav></header>",
      "css": ".ds-mast{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:22px 20px;background:var(--ground);color:var(--ink)}.ds-mast nav{display:flex;align-items:center;gap:18px}.ds-name{font:650 .96875rem/1 var(--font-display);color:var(--ink)}.ds-mast nav a{font:500 .90625rem/1.4 var(--font-display);color:var(--ink-2);padding-block:4px}.ds-ui{text-decoration:none;background:linear-gradient(var(--link-hover),var(--link-hover)) 0 100%/0 1px no-repeat;transition:background-size 220ms cubic-bezier(.2,.7,.2,1),color 120ms ease-out}.ds-ui:hover,.ds-ui:focus-visible{background-size:100% 1px;color:var(--ink)}.ds-ui:focus-visible,.ds-toggle:focus-visible{outline:2px solid var(--focus);outline-offset:3px}.ds-toggle{display:grid;place-items:center;width:32px;height:32px;border:0;background:none;color:var(--ink-2);border-radius:50%;cursor:pointer;transition:color 120ms ease-out}.ds-toggle:hover{color:var(--ink)}"
    },
    {
      "name": "List Row",
      "kind": "card",
      "refersTo": "list-title",
      "description": "Ruled row: Archivo title with a nudging arrow, Graphite side links, serif description below.",
      "html": "<ul class=\"ds-list\"><li><p class=\"ds-title\"><a href=\"#\">Project title<span class=\"ds-arrow\" aria-hidden=\"true\">→</span></a></p><p class=\"ds-side\">Demo · Code</p><p class=\"ds-desc\">What it is, in one line.</p></li><li><p class=\"ds-title\">EY <span class=\"ds-role\">· Technology Consulting Intern</span></p><p class=\"ds-side\">Jun–Aug 2026</p></li></ul>",
      "css": ".ds-list{list-style:none;margin:0;padding:0;color:var(--ink)}.ds-list>li{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2px 16px;padding:12px 0;border-top:1px solid var(--rule)}.ds-list>li:first-child{border-top:0;padding-top:4px}.ds-list p{margin:0}.ds-title{font:600 1.03125rem/1.35 var(--font-display);letter-spacing:-.005em}.ds-title a{color:inherit;text-decoration:none}.ds-title a:hover{color:var(--accent-text)}.ds-title a:focus-visible{outline:2px solid var(--focus);outline-offset:3px}.ds-role{font-weight:400;color:var(--ink-2)}.ds-arrow{display:inline-block;margin-left:.3em;color:var(--ink-2);transition:transform 160ms cubic-bezier(.2,.7,.2,1),color 160ms ease-out}.ds-title a:hover .ds-arrow,.ds-title a:focus-visible .ds-arrow{transform:translateX(4px);color:var(--accent-text)}.ds-side{font:500 .875rem/1.6 var(--font-display);color:var(--ink-2);font-variant-numeric:tabular-nums;text-align:right;white-space:nowrap}.ds-desc{grid-column:1/-1;font-family:var(--font-text);font-size:1rem;line-height:1.5;color:var(--ink-2);max-width:62ch}"
    },
    {
      "name": "Segmented Control",
      "kind": "chip",
      "refersTo": "segment-pressed",
      "description": "Two or more butted buttons; the pressed one fills Ink.",
      "html": "<span class=\"ds-seg\" role=\"group\"><button aria-pressed=\"true\">Small blind jams</button><button aria-pressed=\"false\">Big blind calls</button></span>",
      "css": ".ds-seg{display:inline-flex}.ds-seg button{font:600 .84375rem/1 var(--font-display);color:var(--ink);background:transparent;border:1px solid var(--rule);padding:8px 11px;min-height:34px;margin-left:-1px;border-radius:0;cursor:pointer}.ds-seg button:first-child{margin-left:0;border-radius:6px 0 0 6px}.ds-seg button:last-child{border-radius:0 6px 6px 0}.ds-seg button[aria-pressed=\"true\"]{background:var(--ink);border-color:var(--ink);color:var(--ground)}.ds-seg button:focus-visible{outline:2px solid var(--focus);outline-offset:3px;position:relative}"
    },
    {
      "name": "EV Cells",
      "kind": "custom",
      "refersTo": "ev-cell",
      "description": "A slice of the push/fold grid: hand and EV per cell, heat capped at 80%, cold cells in Graphite.",
      "html": "<div class=\"ds-ev\"><button class=\"ds-cell\" aria-pressed=\"true\" style=\"background-color:color-mix(in srgb,var(--heat) 80%,var(--ground-2))\"><span>AA</span><span>+9.43</span></button><button class=\"ds-cell\" style=\"background-color:color-mix(in srgb,var(--heat) 52%,var(--ground-2))\"><span>AKs</span><span>+4.10</span></button><button class=\"ds-cell\" style=\"background-color:color-mix(in srgb,var(--heat) 24%,var(--ground-2))\"><span>K9o</span><span>+0.21</span></button><button class=\"ds-cell ds-cold\"><span>72o</span><span>−0.62</span></button></div>",
      "css": ".ds-ev{display:grid;grid-template-columns:repeat(4,3rem);gap:1px;background:var(--ground)}.ds-cell{aspect-ratio:1;padding:0;border:0;border-radius:0;background:transparent;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;font:600 .75rem/1.1 var(--font-display);font-variation-settings:'wdth' 75;font-variant-numeric:tabular-nums;color:var(--ink);cursor:pointer;transition:background-color 180ms ease-out,color 180ms ease-out}.ds-cell span+span{font-weight:500}.ds-cold{color:var(--ink-2)}.ds-cell[aria-pressed=\"true\"]{outline:2px solid var(--ink);outline-offset:-2px;position:relative}.ds-cell:focus-visible{outline:2px solid var(--focus);outline-offset:-2px;position:relative;z-index:2}"
    }
  ],
  "narrative": {
    "northStar": "The Plain Record",
    "overview": "Minimal black and white with a soft cobalt accent. Dark is the default and light is a real theme with its own values, not an inversion. Archivo carries names, headings and UI; Source Serif 4 carries reading. The page is one centred column, stacked in order: the name, a degree line, a roles line, Resume and Contact, then short Experience and Projects lists. Home leads with what Ian has done and keeps prose to a sentence where a sentence will do.\n\nDensity is quiet. Ruled lists, small grey section titles, generous space around the name, and almost no chrome. The cobalt is rare on purpose: it appears on hover, focus, selection, the primary button's hover fill, and the push/fold heat. Everything else is ink on ground.\n\nMotion is a handful of small, specific moments. A one-time intro entrance on the first visit to home, in which the name only moves and never starts invisible, so it paints at once and LCP is not delayed. A project title that morphs into its case-study heading through React's `<ViewTransition>` (name `project-<slug>`, `share=\"morph\"`). Hover details: the arrow nudges and the underline draws across. The theme switch wipes the new theme up from the bottom, scoped to `[data-theming]` so navigation keeps its own transition. And a live push/fold EV grid on home. All of it is off under `prefers-reduced-motion`.",
    "keyCharacteristics": [
      "Black, white and one soft cobalt; dark by default, with a real light theme.",
      "Archivo for names, headings and UI; Source Serif 4 for reading.",
      "One centred 760px column with ruled lists and no cards.",
      "Flat and opaque: no shadows anywhere.",
      "Small, authored motion, every piece of it off under reduced motion."
    ],
    "rules": [
      { "name": "The One Blue Rule", "body": "Cobalt is the only hue outside the demos' data and status colours. It marks interaction (hover, focus, selection, pressed fill) and the EV heat, never decoration or a heading.", "section": "colors" },
      { "name": "The Real Light Theme Rule", "body": "Each theme sets its own values for every token. Light is tuned for white paper (a deeper cobalt, a darker Graphite), never computed by inverting dark.", "section": "colors" },
      { "name": "The Two Families Rule", "body": "Archivo for names, headings and UI; Source Serif 4 for reading. No third family beyond monospace for code, and headings are never serif.", "section": "typography" },
      { "name": "The Quiet Section Title Rule", "body": "Section titles are small Graphite Archivo in sentence case. The list under them carries the weight; titles never shout or sit in caps.", "section": "typography" },
      { "name": "The No Shadow Rule", "body": "Nothing casts a shadow: not buttons, lists, the headshot, the range thumb or the grid. A surface that needs separation gets Raised Grey or a Hairline.", "section": "elevation" }
    ],
    "dos": [
      "**Do** keep cobalt for interaction and heat: hover, focus, selection, the primary hover fill, and the EV grid.",
      "**Do** set both themes' value for any new token; the light theme is tuned, not inverted.",
      "**Do** separate list items with 1px Hairline rules and keep lists in the one centred column.",
      "**Do** keep text on any heat or status fill at WCAG AA, as the 80% heat cap does for the EV grid.",
      "**Do** give every motion a reduced-motion state; the global rule turns transitions, animations and view transitions off.",
      "**Do** keep the name visible from the first frame; an entrance may move it but never start it at zero opacity.",
      "**Do** name every chart series and status in text; colour is never the only encoding.",
      "**Do** build Read and Operate styles on these tokens in their own stylesheets, adding no colours or families."
    ],
    "donts": [
      "**Don't** use gradients, gradient text, glassmorphism or grain.",
      "**Don't** cast shadows from anything.",
      "**Don't** fade or slide sections in on scroll; the intro plays once, on home, and nothing else enters.",
      "**Don't** box lists into cards or give them coloured left borders.",
      "**Don't** let a button fade on hover; it swaps to a solid fill.",
      "**Don't** set headings or accent words in serif italic.",
      "**Don't** put a badge or caps eyebrow above a heading.",
      "**Don't** add an icon set; the theme switch's half-disc is the one drawn icon."
    ]
  }
}
